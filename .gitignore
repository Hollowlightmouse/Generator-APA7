# Un solo .gitignore para todo el repo. Los patrones sin barra inicial
# aplazan a cualquier nivel, asi que las reglas cubren tambien
# generate-apa-document/ y cualquier subcarpeta.

# --- Estado generado por la skill (no es codigo fuente) ---------------------
# .work/ contiene node_modules con la libreria docx.
.work/
# Entorno virtual de Python con pymupdf fijado: cientos de MB, lo crea
# scripts/apa7.py install.
.venv/
venv/
# Dependencias de Node. Normalmente viven dentro de .work/, pero si APA7_NODEDIR
# apunta a otro sitio (por ejemplo la carpeta de la skill) dejarian node_modules
# suelto en el arbol del repositorio.
node_modules/

# --- Datos de entorno y rutas locales ---------------------------------------
# Configuracion local por maquina: nunca se versiona.
.env
.env.*
*.env
# Credenciales sueltas, por si se guardan en un archivo sin extension.
*.key
*.pem

# Lista de terminos intocables: dato de un documento concreto, nunca del repo.
# El deglue ya no la consume (se revisa en el .md fuente); la regla queda como
# red de seguridad para copias locales de instalaciones viejas.
terms-whitelist.txt

# --- Banco de pruebas local -------------------------------------------------
# Fixtures, salidas .docx/.pdf y logs de cada corrida
.pruebas/
evaluacion/
# Documento real de trabajo (con datos personales: docente, institucion, NRC).
# Es material local de pruebas, nunca fuente del repositorio.
Prueba/

# --- Estado de corrida del pipeline ----------------------------------------
_logs/
*.log
__pycache__/
*.py[cod]

# Carpeta de trabajo de un documento: <nombre>_apa/ con datos/ y logs/. Vive
# junto al .md que se esta convirtiendo, nunca dentro de la skill.
*_apa/

# --- Salidas generadas por la skill -----------------------------------------
*.docx
*.pdf
MANIFEST.json
MANIFIEST.json

# --- Editores / SO ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
