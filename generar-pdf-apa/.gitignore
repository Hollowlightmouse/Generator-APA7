# Estado generado en tiempo de ejecucion: NO versionar.
# .work/ contiene node_modules con la libreria docx.
# El perfil aislado de LibreOffice ya NO vive aqui: cada corrida lo crea en el
# directorio _logs/ del documento de salida.
# Se regenera con scripts\instalar-entorno.ps1
.work/

# Compilados de Python
__pycache__/
*.py[cod]

# Logs de cada corrida del pipeline
_logs/
*.log
